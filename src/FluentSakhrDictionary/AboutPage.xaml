<Page
    x:Class="FluentSakhrDictionary.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer x:Name="RootScroll">
        <StackPanel Padding="32" Spacing="6" MaxWidth="560">
            <TextBlock x:Name="HeaderText" Text="About" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16"/>

            <Border CornerRadius="12" Padding="24"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="10" HorizontalAlignment="Center">
                    <Image Source="/app-icon-256.png" Width="96" Height="96"/>
                    <TextBlock Text="Sakhr Dictionary Revive" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="قاموس صخر" FontSize="18" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="VersionText" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="DescText" Text="A modern rebirth of the classic 1996 Sakhr English-Arabic dictionary: 59,427 lemmas, 125,896 Arabic meanings with full diacritics."
                               FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="OfflineText" Text="Works fully offline - both databases are bundled inside the app, no internet needed."
                               FontSize="13" TextWrapping="Wrap" TextAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <Border CornerRadius="12" Padding="24" Margin="0,12,0,0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="8">
                    <HyperlinkButton x:Name="CreditLink" Content="brought to you by Instinct"
                                     NavigateUri="https://instinct.com"
                                     FontSize="14" FontWeight="SemiBold" Padding="0"/>
                    <TextBlock x:Name="DevText" Text="Developer: Mohamed Elnaggar" FontSize="13"/>
                    <TextBlock x:Name="ContribText" Text="Contributors: app.instinct" FontSize="13"/>
                    <TextBlock x:Name="LicenseText" Text="License: MIT" FontSize="13"/>
                    <TextBlock x:Name="DataEnText" Text="English-Arabic data: the original 1996 Sakhr dictionary" FontSize="13"/>
                    <TextBlock x:Name="DataArText" Text="Arabic-English data: English Wiktionary via kaikki.org (wiktextract), CC BY-SA 4.0" FontSize="13" TextWrapping="Wrap"/>
                    <HyperlinkButton x:Name="RepoLink" Content="github.com/Star-Dust-0/Sakhr-Dictionary-Revive"
                                     NavigateUri="https://github.com/Star-Dust-0/Sakhr-Dictionary-Revive"
                                     FontSize="13" Padding="0"/>
                </StackPanel>
            </Border>
            <Border CornerRadius="12" Padding="24" Margin="0,12,0,0" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel Spacing="8">
            <TextBlock x:Name="UpdatesHeader" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="UpdatesNote" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
            <Button x:Name="CheckButton" Click="CheckUpdates_Click"/><TextBlock x:Name="UpdateResult" TextWrapping="Wrap"/><HyperlinkButton x:Name="UpdateLink" Visibility="Collapsed"/>
            </StackPanel></Border>
        </StackPanel>
    </ScrollViewer>
</Page>

